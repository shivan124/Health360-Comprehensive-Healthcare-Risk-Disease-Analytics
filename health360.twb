      <aliases enabled='yes' />
      <column caption='Any Chronic Disease' datatype='integer' name='[Calculation_1605074056040448]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [heart_disease] = 1&#13;&#10;OR [diabetes] = 1&#13;&#10;OR [stroke] = 1&#13;&#10;THEN 1&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1605074057887745]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [age] &lt; 30 THEN &quot;18-29&quot;&#13;&#10;ELSEIF [age] &lt; 40 THEN &quot;30-39&quot;&#13;&#10;ELSEIF [age] &lt; 50 THEN &quot;40-49&quot;&#13;&#10;ELSEIF [age] &lt; 60 THEN &quot;50-59&quot;&#13;&#10;ELSEIF [age] &lt; 70 THEN &quot;60-69&quot;&#13;&#10;ELSE &quot;70+&quot;&#13;&#10;END' />
      </column>
      <column caption='BMI Category' datatype='string' name='[Calculation_1605074059022338]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot;&#13;&#10;ELSEIF [bmi] &lt; 25 THEN &quot;Normal&quot;&#13;&#10;ELSEIF [bmi] &lt; 30 THEN &quot;Overweight&quot;&#13;&#10;ELSE &quot;Obese&quot;&#13;&#10;END' />
      </column>
      <column caption='Symptom Count' datatype='integer' name='[Calculation_1605074059882499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT([fatigue])&#13;&#10;+&#13;&#10;INT([chest_pain])&#13;&#10;+&#13;&#10;INT([dizziness])' />
      </column>
      <column caption='Symptom Group' datatype='string' name='[Calculation_1605074060177412]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1605074059882499] = 0 THEN &quot;No Symptoms&quot;&#13;&#10;ELSEIF [Calculation_1605074059882499] = 1 THEN &quot;1 Symptoms&quot;&#13;&#10;ELSEIF [Calculation_1605074059882499] = 2 THEN &quot;2 Symptoms&quot;&#13;&#10;ELSE &quot;3 Symptoms&quot;&#13;&#10;END' />
      </column>
      <column caption='Disease Prevalence' datatype='real' name='[Calculation_1605074060775429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1605074056040448])' />
      </column>
